# SalesGenie AI Backend Configuration
# Copy this file to .env and fill in your values

# JWT Secret Key (REQUIRED - change this to a random secure key in production!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# NVIDIA AI API Key (optional - for AI-powered outreach generation)
# Get your free API key from: https://build.nvidia.com/
NVIDIA_API_KEY=

# OpenAI / GLM-4.5 / Custom LLM API Configuration
# Models supported: glm-4.5, gpt-4o-mini, etc.
LLM_MODEL=glm-4.5
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
